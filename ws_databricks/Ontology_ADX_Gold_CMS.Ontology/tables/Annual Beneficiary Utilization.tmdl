/// Annual beneficiary-level fact table at beneficiary-year grain, with annual geography/demographics, age, coverage months, condition indicators, Medicare reimbursement, and inpatient/outpatient utilization. Supports year/state/demographic/beneficiary analysis. Multi-year population averages and prevalence measures are beneficiary-year weighted; Total Beneficiaries counts distinct people. No provider relationship.
table 'Annual Beneficiary Utilization'
	lineageTag: 00000000-0000-0000-0000-69bd460dcd85
	sourceLineageTag: 00000000-0000-0000-0000-068509ae3ddd

	/// Distinct beneficiaries with annual utilization records in the current year, state, demographic, and beneficiary context. Non-additive across years. Provider and claim-type dimensions do not filter this population.
	measure 'Total Beneficiaries' = EXTERNALMEASURE("Total Beneficiaries", INTEGER, "DirectQuery to AS - 00000000-0000-0000-0000-4f0a9fa9337a/00000000-0000-0000-0000-171fc01efbf5")
		formatString: #,0
		displayFolder: Population
		lineageTag: 00000000-0000-0000-0000-dd90adeebbac
		sourceLineageTag: 00000000-0000-0000-0000-8201768d6502

	/// Number of beneficiary-year observations in the current context. Denominator for observation-weighted averages and prevalence; a person can contribute once per selected year.
	measure 'Beneficiary-Year Count' = EXTERNALMEASURE("Beneficiary-Year Count", INTEGER, "DirectQuery to AS - 00000000-0000-0000-0000-4f0a9fa9337a/00000000-0000-0000-0000-171fc01efbf5")
		formatString: #,0
		displayFolder: Population
		lineageTag: 00000000-0000-0000-0000-907f3c9fd872
		sourceLineageTag: 00000000-0000-0000-0000-982efca5144c

	/// Mean age at year end across nonblank beneficiary-year observations in the selected years, states, demographics, and beneficiaries. Not an average of subgroup averages.
	measure 'Average Age' = EXTERNALMEASURE("Average Age", DOUBLE, "DirectQuery to AS - 00000000-0000-0000-0000-4f0a9fa9337a/00000000-0000-0000-0000-171fc01efbf5")
		formatString: 0.0
		displayFolder: Population
		lineageTag: 00000000-0000-0000-0000-ea711b4a545f
		sourceLineageTag: 00000000-0000-0000-0000-e50e22c12527

	/// Mean chronic condition count across nonblank beneficiary-year observations in the current context.
	measure 'Average Chronic Condition Count' = EXTERNALMEASURE("Average Chronic Condition Count", DOUBLE, "DirectQuery to AS - 00000000-0000-0000-0000-4f0a9fa9337a/00000000-0000-0000-0000-171fc01efbf5")
		formatString: 0.00
		displayFolder: Population
		lineageTag: 00000000-0000-0000-0000-358902e70e6d
		sourceLineageTag: 00000000-0000-0000-0000-e4486e51f94d

	/// Total annual Medicare reimbursement, including inpatient, outpatient, and carrier amounts. Responds to year, state, demographic, and beneficiary filters, not provider or claim-type filters. Not equivalent to institutional claim payments.
	measure 'Total Medicare Reimbursement' = EXTERNALMEASURE("Total Medicare Reimbursement", DOUBLE, "DirectQuery to AS - 00000000-0000-0000-0000-4f0a9fa9337a/00000000-0000-0000-0000-171fc01efbf5")
		formatString: $#,0.00;($#,0.00);$0.00
		displayFolder: Reimbursement
		lineageTag: 00000000-0000-0000-0000-ecff583145a9
		sourceLineageTag: 00000000-0000-0000-0000-fc7f4f427a2b

	/// Selected-period Medicare reimbursement divided by distinct beneficiaries in that period. For multiple years, this is cumulative reimbursement per distinct person, not per beneficiary-year. Blank for an empty denominator.
	measure 'Reimbursement per Beneficiary' = EXTERNALMEASURE("Reimbursement per Beneficiary", DOUBLE, "DirectQuery to AS - 00000000-0000-0000-0000-4f0a9fa9337a/00000000-0000-0000-0000-171fc01efbf5")
		formatString: $#,0.00;($#,0.00);$0.00
		displayFolder: Reimbursement
		lineageTag: 00000000-0000-0000-0000-fba7e1022b9f
		sourceLineageTag: 00000000-0000-0000-0000-6edeb298307c

	/// Inpatient plus outpatient claim counts from annual beneficiary utilization. Use with Calendar Year, State, Demographic, Beneficiary, and Claim Type dimensions. No provider attribution is available; Provider does not filter this measure. Excludes claims outside beneficiary summary coverage.
	measure 'Total Beneficiary Claims' = EXTERNALMEASURE("Total Beneficiary Claims", INTEGER, "DirectQuery to AS - 00000000-0000-0000-0000-4f0a9fa9337a/00000000-0000-0000-0000-171fc01efbf5")
		formatString: #,0
		displayFolder: Claims\Beneficiary
		lineageTag: 00000000-0000-0000-0000-e5917b8be74e
		sourceLineageTag: 00000000-0000-0000-0000-cecf32f3a88b

	/// Inpatient claims in annual beneficiary utilization, respecting year, state, demographic, beneficiary, and selected Claim Type. Blank when Inpatient is excluded. Provider filters are not supported.
	measure 'Beneficiary Inpatient Claim Count' = EXTERNALMEASURE("Beneficiary Inpatient Claim Count", INTEGER, "DirectQuery to AS - 00000000-0000-0000-0000-4f0a9fa9337a/00000000-0000-0000-0000-171fc01efbf5")
		formatString: #,0
