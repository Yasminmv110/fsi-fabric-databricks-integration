/// Provider dimension keyed by Provider Number, containing observed claim-year range and indicators for inpatient/outpatient claims. Filters Annual Provider Claims Summary only; the model has no provider-to-beneficiary/state/demographic attribution.
entity Provider
	lineageTag: 00000000-0000-0000-0000-3d4be6a05039
	backingTable: Provider

	/// Source provider identifier and unique key of the Provider dimension. Joins to Annual Provider Claims Summary; not assumed to be a National Provider Identifier.
	property provider_number
		dataType: string
		lineageTag: 00000000-0000-0000-0000-cd8724f81372

		backingConfiguration
			valueColumn: Provider.'Provider Number'

		synonym 'Provider Number'

		synonym 'Provider ID'

		synonym 'Provider Identifier'

	/// Earliest claim year observed for this provider in the loaded data; not necessarily the provider's first year of operation.
	property first_claim_year
		dataType: int64
		lineageTag: 00000000-0000-0000-0000-44ffb16344e4

		backingConfiguration
			valueColumn: Provider.'First Claim Year'

		synonym 'First Claim Year'

		synonym 'Earliest Claim Year'

	/// Latest claim year observed for this provider in the loaded data; not necessarily the provider's last year of operation.
	property last_claim_year
		dataType: int64
		lineageTag: 00000000-0000-0000-0000-5ae3777473c2

		backingConfiguration
			valueColumn: Provider.'Last Claim Year'

		synonym 'Last Claim Year'

		synonym 'Most Recent Claim Year'

	/// Source indicator that this provider has inpatient claims in the loaded data. Describes observed claim-type presence, not the number of claims.
	property has_inpatient_claims
		dataType: int64
		lineageTag: 00000000-0000-0000-0000-5098d5b5d097

		backingConfiguration
			valueColumn: Provider.'Has Inpatient Claims'

		synonym 'Has Inpatient Claims'

		synonym 'Inpatient Claims Indicator'

	/// Source indicator that this provider has outpatient claims in the loaded data. Describes observed claim-type presence, not the number of claims.
	property has_outpatient_claims
		dataType: int64
		lineageTag: 00000000-0000-0000-0000-9bdbd1ed259d

		backingConfiguration
			valueColumn: Provider.'Has Outpatient Claims'

		synonym 'Has Outpatient Claims'

		synonym 'Outpatient Claims Indicator'

	/// Recorded load timestamp for this gold-layer provider record. Operational lineage metadata, not a claim date.
	property _gold_load_ts
		dataType: dateTime
		lineageTag: 00000000-0000-0000-0000-918f1dbdd4c6

		backingConfiguration
			valueColumn: Provider.'Gold Load Timestamp'

		synonym 'Gold Load Timestamp'

		synonym 'Gold Layer Load Timestamp'

		synonym 'Gold Load Time'

