model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["DirectLake - WH_ADX_CMS_Gold"]

annotation PBI_ProTooling = ["DirectLakeOnOneLakeInWeb","WebModelingEdit","MCP-PBIModeling"]

ref table Beneficiary
ref table 'Claim Type'
ref table Demographic
ref table Provider
ref table State
ref table 'Calendar Year'
ref table 'Annual Beneficiary Utilization'
ref table 'Population Health Summary'
ref table 'Annual Provider Claims Summary'

