/// Annual beneficiary-level fact table at beneficiary-year grain, with annual geography/demographics, age, coverage months, condition indicators, Medicare reimbursement, and inpatient/outpatient utilization. Supports year/state/demographic/beneficiary analysis. Multi-year population averages and prevalence measures are beneficiary-year weighted; Total Beneficiaries counts distinct people. No provider relationship.
table 'Annual Beneficiary Utilization'
	lineageTag: 00000000-0000-0000-0000-000000000000
	sourceLineageTag: [gold].[fact_beneficiary_annual_utilization]

	/// Distinct beneficiaries with annual utilization records in the current year, state, demographic, and beneficiary context. Non-additive across years. Provider and claim-type dimensions do not filter this population.
	measure 'Total Beneficiaries' = DISTINCTCOUNTNOBLANK('Annual Beneficiary Utilization'[Beneficiary ID])
		formatString: #,0
		displayFolder: Population
		lineageTag: 00000000-0000-0000-0000-000000000000

	/// Number of beneficiary-year observations in the current context. Denominator for observation-weighted averages and prevalence; a person can contribute once per selected year.
	measure 'Beneficiary-Year Count' = COUNTROWS('Annual Beneficiary Utilization')
		formatString: #,0
		displayFolder: Population
		lineageTag: 00000000-0000-0000-0000-000000000000

	/// Mean age at year end across nonblank beneficiary-year observations in the selected years, states, demographics, and beneficiaries. Not an average of subgroup averages.
	measure 'Average Age' = AVERAGE('Annual Beneficiary Utilization'[Age at Year End])
		formatString: 0.0
		displayFolder: Population
		lineageTag: 00000000-0000-0000-0000-000000000000

	/// Mean chronic condition count across nonblank beneficiary-year observations in the current context.
	measure 'Average Chronic Condition Count' = AVERAGE('Annual Beneficiary Utilization'[Chronic Condition Count])
		formatString: 0.00
		displayFolder: Population
		lineageTag: 00000000-0000-0000-0000-000000000000

	/// Total annual Medicare reimbursement, including inpatient, outpatient, and carrier amounts. Responds to year, state, demographic, and beneficiary filters, not provider or claim-type filters. Not equivalent to institutional claim payments.
	measure 'Total Medicare Reimbursement' = SUM('Annual Beneficiary Utilization'[Total Medicare Reimbursement Amount])
		formatString: $#,0.00;($#,0.00);$0.00
		displayFolder: Reimbursement
		lineageTag: 00000000-0000-0000-0000-000000000000

	/// Selected-period Medicare reimbursement divided by distinct beneficiaries in that period. For multiple years, this is cumulative reimbursement per distinct person, not per beneficiary-year. Blank for an empty denominator.
	measure 'Reimbursement per Beneficiary' = DIVIDE([Total Medicare Reimbursement], [Total Beneficiaries])
		formatString: $#,0.00;($#,0.00);$0.00
		displayFolder: Reimbursement
		lineageTag: 00000000-0000-0000-0000-000000000000

	/// Inpatient plus outpatient claim counts from annual beneficiary utilization. Use with Calendar Year, State, Demographic, Beneficiary, and Claim Type dimensions. No provider attribution is available; Provider does not filter this measure. Excludes claims outside beneficiary summary coverage.
	measure 'Total Beneficiary Claims' = [Beneficiary Inpatient Claim Count] + [Beneficiary Outpatient Claim Count]
		formatString: #,0
		displayFolder: Claims\Beneficiary
		lineageTag: 00000000-0000-0000-0000-000000000000

	/// Inpatient claims in annual beneficiary utilization, respecting year, state, demographic, beneficiary, and selected Claim Type. Blank when Inpatient is excluded. Provider filters are not supported.
	measure 'Beneficiary Inpatient Claim Count' = IF("Inpatient" IN VALUES('Claim Type'[Claim Type]), SUM('Annual Beneficiary Utilization'[Inpatient Claim Count]))
		formatString: #,0
		displayFolder: Claims\Beneficiary
		lineageTag: 00000000-0000-0000-0000-000000000000

	/// Outpatient claims in annual beneficiary utilization, respecting year, state, demographic, beneficiary, and selected Claim Type. Blank when Outpatient is excluded. Provider filters are not supported.
	measure 'Beneficiary Outpatient Claim Count' = IF("Outpatient" IN VALUES('Claim Type'[Claim Type]), SUM('Annual Beneficiary Utilization'[Outpatient Claim Count]))
		formatString: #,0
		displayFolder: Claims\Beneficiary
		lineageTag: 00000000-0000-0000-0000-000000000000

	/// Share of beneficiary-year observations flagged with Alzheimer's disease. Respects year, state, demographic, and beneficiary filters; not provider or claim type. Multiple years are observation-weighted. Blank for an empty denominator.
	measure 'Alzheimer''s Disease Prevalence Rate' = DIVIDE(CALCULATE([Beneficiary-Year Count], KEEPFILTERS('Annual Beneficiary Utilization'[Has Alzheimer's Disease] = 1)), [Beneficiary-Year Count])
		formatString: 0.00%
		displayFolder: Population\Prevalence
		lineageTag: 00000000-0000-0000-0000-000000000000

	/// Share of beneficiary-year observations flagged with heart failure. Respects year, state, demographic, and beneficiary filters; not provider or claim type. Multiple years are observation-weighted. Blank for an empty denominator.
	measure 'Heart Failure Prevalence Rate' = DIVIDE(CALCULATE([Beneficiary-Year Count], KEEPFILTERS('Annual Beneficiary Utilization'[Has Heart Failure] = 1)), [Beneficiary-Year Count])
		formatString: 0.00%
		displayFolder: Population\Prevalence
		lineageTag: 00000000-0000-0000-0000-000000000000

	/// Share of beneficiary-year observations flagged with chronic kidney disease. Respects year, state, demographic, and beneficiary filters; not provider or claim type. Multiple years are observation-weighted. Blank for an empty denominator.
	measure 'Chronic Kidney Disease Prevalence Rate' = DIVIDE(CALCULATE([Beneficiary-Year Count], KEEPFILTERS('Annual Beneficiary Utilization'[Has Chronic Kidney Disease] = 1)), [Beneficiary-Year Count])
		formatString: 0.00%
		displayFolder: Population\Prevalence
		lineageTag: 00000000-0000-0000-0000-000000000000

	/// Share of beneficiary-year observations flagged with cancer. Respects year, state, demographic, and beneficiary filters; not provider or claim type. Multiple years are observation-weighted. Blank for an empty denominator.
	measure 'Cancer Prevalence Rate' = DIVIDE(CALCULATE([Beneficiary-Year Count], KEEPFILTERS('Annual Beneficiary Utilization'[Has Cancer] = 1)), [Beneficiary-Year Count])
		formatString: 0.00%
		displayFolder: Population\Prevalence
		lineageTag: 00000000-0000-0000-0000-000000000000

	/// Share of beneficiary-year observations flagged with COPD. Respects year, state, demographic, and beneficiary filters; not provider or claim type. Multiple years are observation-weighted. Blank for an empty denominator.
	measure 'COPD Prevalence Rate' = DIVIDE(CALCULATE([Beneficiary-Year Count], KEEPFILTERS('Annual Beneficiary Utilization'[Has COPD] = 1)), [Beneficiary-Year Count])
		formatString: 0.00%
		displayFolder: Population\Prevalence
		lineageTag: 00000000-0000-0000-0000-000000000000

	/// Share of beneficiary-year observations flagged with depression. Respects year, state, demographic, and beneficiary filters; not provider or claim type. Multiple years are observation-weighted. Blank for an empty denominator.
	measure 'Depression Prevalence Rate' = DIVIDE(CALCULATE([Beneficiary-Year Count], KEEPFILTERS('Annual Beneficiary Utilization'[Has Depression] = 1)), [Beneficiary-Year Count])
		formatString: 0.00%
		displayFolder: Population\Prevalence
		lineageTag: 00000000-0000-0000-0000-000000000000

	/// Share of beneficiary-year observations flagged with diabetes. Respects year, state, demographic, and beneficiary filters; not provider or claim type. Multiple years are observation-weighted. Blank for an empty denominator.
	measure 'Diabetes Prevalence Rate' = DIVIDE(CALCULATE([Beneficiary-Year Count], KEEPFILTERS('Annual Beneficiary Utilization'[Has Diabetes] = 1)), [Beneficiary-Year Count])
		formatString: 0.00%
		displayFolder: Population\Prevalence
		lineageTag: 00000000-0000-0000-0000-000000000000

	/// Share of beneficiary-year observations flagged with ischemic heart disease. Respects year, state, demographic, and beneficiary filters; not provider or claim type. Multiple years are observation-weighted. Blank for an empty denominator.
	measure 'Ischemic Heart Disease Prevalence Rate' = DIVIDE(CALCULATE([Beneficiary-Year Count], KEEPFILTERS('Annual Beneficiary Utilization'[Has Ischemic Heart Disease] = 1)), [Beneficiary-Year Count])
		formatString: 0.00%
		displayFolder: Population\Prevalence
		lineageTag: 00000000-0000-0000-0000-000000000000

	/// Share of beneficiary-year observations flagged with osteoporosis. Respects year, state, demographic, and beneficiary filters; not provider or claim type. Multiple years are observation-weighted. Blank for an empty denominator.
	measure 'Osteoporosis Prevalence Rate' = DIVIDE(CALCULATE([Beneficiary-Year Count], KEEPFILTERS('Annual Beneficiary Utilization'[Has Osteoporosis] = 1)), [Beneficiary-Year Count])
		formatString: 0.00%
		displayFolder: Population\Prevalence
		lineageTag: 00000000-0000-0000-0000-000000000000

	/// Share of beneficiary-year observations flagged with rheumatoid/osteo arthritis. Respects year, state, demographic, and beneficiary filters; not provider or claim type. Multiple years are observation-weighted. Blank for an empty denominator.
	measure 'Rheumatoid/Osteo Arthritis Prevalence Rate' = DIVIDE(CALCULATE([Beneficiary-Year Count], KEEPFILTERS('Annual Beneficiary Utilization'[Has Rheumatoid/Osteo Arthritis] = 1)), [Beneficiary-Year Count])
		formatString: 0.00%
		displayFolder: Population\Prevalence
		lineageTag: 00000000-0000-0000-0000-000000000000

	/// Share of beneficiary-year observations flagged with stroke/TIA. Respects year, state, demographic, and beneficiary filters; not provider or claim type. Multiple years are observation-weighted. Blank for an empty denominator.
	measure 'Stroke/TIA Prevalence Rate' = DIVIDE(CALCULATE([Beneficiary-Year Count], KEEPFILTERS('Annual Beneficiary Utilization'[Has Stroke/TIA] = 1)), [Beneficiary-Year Count])
		formatString: 0.00%
		displayFolder: Population\Prevalence
		lineageTag: 00000000-0000-0000-0000-000000000000

	/// Share of beneficiary-year observations flagged with end-stage renal disease. Respects year, state, demographic, and beneficiary filters; not provider or claim type. Multiple years are observation-weighted. Blank for an empty denominator.
	measure 'End-Stage Renal Disease Prevalence Rate' = DIVIDE(CALCULATE([Beneficiary-Year Count], KEEPFILTERS('Annual Beneficiary Utilization'[Has End-Stage Renal Disease] = 1)), [Beneficiary-Year Count])
		formatString: 0.00%
		displayFolder: Population\Prevalence
		lineageTag: 00000000-0000-0000-0000-000000000000

	/// Share of beneficiary-year observations with three or more chronic conditions. Respects year, state, demographic, and beneficiary filters; not provider or claim type. Multiple years are observation-weighted. Blank for an empty denominator.
	measure '3+ Chronic Conditions Prevalence Rate' = DIVIDE(CALCULATE([Beneficiary-Year Count], KEEPFILTERS('Annual Beneficiary Utilization'[Chronic Condition Count] >= 3)), [Beneficiary-Year Count])
		formatString: 0.00%
		displayFolder: Population\Prevalence
		lineageTag: 00000000-0000-0000-0000-000000000000

