/// Claim-type dimension distinguishing inpatient Part A institutional claims from outpatient Part B institutional claims. Filters Annual Provider Claims Summary through its active relationship. Beneficiary claim-count measures also apply this selection explicitly; population and reimbursement measures do not.
table 'Claim Type'
	lineageTag: 00000000-0000-0000-0000-000000000000
	sourceLineageTag: [gold].[dim_claim_type]

	/// Claim category key: Inpatient or Outpatient. Relates to Annual Provider Claims Summary; beneficiary claim-count measures also interpret this selection explicitly.
	column 'Claim Type'
		dataType: string
		lineageTag: 00000000-0000-0000-0000-000000000000
		sourceLineageTag: claim_type
		summarizeBy: none
		sourceColumn: claim_type

		annotation SummarizationSetBy = Automatic

	/// Readable definition of the claim category: Part A institutional inpatient claims or Part B institutional outpatient claims.
	column 'Claim Type Description'
		dataType: string
		lineageTag: 00000000-0000-0000-0000-000000000000
		sourceLineageTag: claim_type_description
		summarizeBy: none
		sourceColumn: claim_type_description

		annotation SummarizationSetBy = Automatic

	/// Recorded load timestamp for this gold-layer claim-type record. Operational lineage metadata, not a claim date.
	column 'Gold Load Timestamp'
		dataType: dateTime
		isHidden
		formatString: General Date
		lineageTag: 00000000-0000-0000-0000-000000000000
		sourceLineageTag: _gold_load_ts
		summarizeBy: none
		sourceColumn: _gold_load_ts

		annotation SummarizationSetBy = Automatic

	partition dim_claim_type = entity
		mode: directLake
		source
			entityName: dim_claim_type
			schemaName: gold
			expressionSource: 'DirectLake - WH_ADX_CMS_Gold'
