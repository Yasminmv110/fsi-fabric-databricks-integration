/// Demographic dimension keyed by Demographic Key, with sex, race, age band, and display-sort columns. Filters Annual Beneficiary Utilization and Population Health Summary. Represents the demographic grouping attached to each annual summary, not a provider characteristic.
table Demographic
	lineageTag: 00000000-0000-0000-0000-000000000000
	sourceLineageTag: [gold].[dim_demographic]

	/// Unique key identifying a demographic combination of sex, race, and age band. Joins to annual beneficiary utilization and population health summaries.
	column 'Demographic Key'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 00000000-0000-0000-0000-000000000000
		sourceLineageTag: demographic_key
		summarizeBy: none
		sourceColumn: demographic_key

		annotation SummarizationSetBy = Automatic

	/// Source sex category for this annual demographic grouping. Use to slice beneficiary and population-health measures; does not filter provider claims.
	column Sex
		dataType: string
		lineageTag: 00000000-0000-0000-0000-000000000000
		sourceLineageTag: sex
		summarizeBy: none
		sourceColumn: sex

		annotation SummarizationSetBy = Automatic

	/// Source race category for this annual demographic grouping. Use to slice beneficiary and population-health measures; does not filter provider claims.
	column Race
		dataType: string
		lineageTag: 00000000-0000-0000-0000-000000000000
		sourceLineageTag: race
		summarizeBy: none
		sourceColumn: race

		annotation SummarizationSetBy = Automatic

	/// Age-range label for this demographic grouping. Use with annual beneficiary and population summaries; Age Band Sort Order supplies the intended display sequence.
	column 'Age Band'
		dataType: string
		lineageTag: 00000000-0000-0000-0000-000000000000
		sourceLineageTag: age_band
		summarizeBy: none
		sourceColumn: age_band

		annotation SummarizationSetBy = Automatic

	/// Numeric display-order value for sex categories. Technical sorting metadata; not a population metric and should not be aggregated.
	column 'Sex Sort Order'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 00000000-0000-0000-0000-000000000000
		sourceLineageTag: sex_sort
		summarizeBy: sum
		sourceColumn: sex_sort

		annotation SummarizationSetBy = Automatic

	/// Numeric display-order value for race categories. Technical sorting metadata; not a population metric and should not be aggregated.
	column 'Race Sort Order'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 00000000-0000-0000-0000-000000000000
		sourceLineageTag: race_sort
		summarizeBy: sum
		sourceColumn: race_sort

		annotation SummarizationSetBy = Automatic

	/// Numeric display-order value for age bands. Technical sorting metadata; not an age or population metric and should not be aggregated.
	column 'Age Band Sort Order'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 00000000-0000-0000-0000-000000000000
		sourceLineageTag: age_band_sort
		summarizeBy: sum
		sourceColumn: age_band_sort

		annotation SummarizationSetBy = Automatic

	/// Recorded load timestamp for this gold-layer demographic record. Operational lineage metadata, not the summary year.
	column 'Gold Load Timestamp'
		dataType: dateTime
		isHidden
		formatString: General Date
		lineageTag: 00000000-0000-0000-0000-000000000000
		sourceLineageTag: _gold_load_ts
		summarizeBy: none
		sourceColumn: _gold_load_ts

		annotation SummarizationSetBy = Automatic

	partition dim_demographic = entity
		mode: directLake
		source
			entityName: dim_demographic
			schemaName: gold
			expressionSource: 'DirectLake - WH_ADX_CMS_Gold'
