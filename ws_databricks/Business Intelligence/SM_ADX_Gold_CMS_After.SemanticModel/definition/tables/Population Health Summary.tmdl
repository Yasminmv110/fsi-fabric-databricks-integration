/// Preaggregated population-health fact table at Summary Year, State Code, and Demographic Key grain. Contains beneficiary/condition counts, averages, prevalence, reimbursement, and institutional utilization. Additive counts can be summed across disjoint groups, but averages, rates, and per-beneficiary values must be recomputed or weighted rather than summed. Does not support provider attribution.
table 'Population Health Summary'
	lineageTag: 00000000-0000-0000-0000-000000000000
	sourceLineageTag: [gold].[fact_population_health_summary]

	/// Calendar year represented by this population summary group. Foreign key to Calendar Year and part of the year/state/demographic grain.
	column 'Summary Year'
		dataType: int64
		formatString: 0
		lineageTag: 00000000-0000-0000-0000-000000000000
		sourceLineageTag: summary_year
		summarizeBy: none
		sourceColumn: summary_year

		annotation SummarizationSetBy = Automatic

	/// Source state code for this population group. Foreign key to State and part of the year/state/demographic grain.
	column 'State Code'
		dataType: string
		lineageTag: 00000000-0000-0000-0000-000000000000
		sourceLineageTag: state_code
		summarizeBy: none
		sourceColumn: state_code

		annotation SummarizationSetBy = Automatic

	/// Foreign key to the sex/race/age-band grouping in Demographic. Part of the year/state/demographic summary grain.
	column 'Demographic Key'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 00000000-0000-0000-0000-000000000000
		sourceLineageTag: demographic_key
		summarizeBy: none
		sourceColumn: demographic_key

		annotation SummarizationSetBy = Automatic

	/// Number of beneficiaries in this year/state/demographic group. Summing across years counts beneficiary-year observations, not distinct people across the selected period.
	column 'Beneficiary Count'
		dataType: int64
		formatString: 0
		lineageTag: 00000000-0000-0000-0000-000000000000
		sourceLineageTag: beneficiary_count
		summarizeBy: sum
		sourceColumn: beneficiary_count

		annotation SummarizationSetBy = Automatic

	/// Number of beneficiaries flagged as deceased in this annual population group. Across years, the same person may contribute to more than one observation.
	column 'Deceased Beneficiary Count'
		dataType: int64
		formatString: 0
		lineageTag: 00000000-0000-0000-0000-000000000000
		sourceLineageTag: deceased_count
		summarizeBy: sum
		sourceColumn: deceased_count

		annotation SummarizationSetBy = Automatic

	/// Number of beneficiaries with the end-stage renal disease indicator in this annual population group. Divide by the matching Beneficiary Count for group prevalence.
	column 'End-Stage Renal Disease Count'
		dataType: int64
		formatString: 0
		lineageTag: 00000000-0000-0000-0000-000000000000
		sourceLineageTag: esrd_count
		summarizeBy: sum
		sourceColumn: esrd_count

		annotation SummarizationSetBy = Automatic

	/// Precomputed mean beneficiary age for this year/state/demographic group. Do not sum or take an unweighted mean across groups; use the Average Age measure for observation-weighted reporting.
	column 'Average Age'
		dataType: decimal
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 00000000-0000-0000-0000-000000000000
		sourceLineageTag: avg_age
		summarizeBy: sum
		sourceColumn: avg_age

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Precomputed mean chronic condition count for this annual population group. Do not sum or average groups equally; use the Average Chronic Condition Count measure.
	column 'Average Chronic Condition Count'
		dataType: decimal
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 00000000-0000-0000-0000-000000000000
		sourceLineageTag: avg_chronic_condition_count
		summarizeBy: sum
		sourceColumn: avg_chronic_condition_count

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Number of beneficiaries with at least three recorded chronic conditions in this annual population group. Divide aggregated counts by matching beneficiary-year counts for prevalence.
	column 'Beneficiaries with 3+ Chronic Conditions'
		dataType: int64
		formatString: 0
		lineageTag: 00000000-0000-0000-0000-000000000000
		sourceLineageTag: multi_chronic_3plus_count
		summarizeBy: sum
		sourceColumn: multi_chronic_3plus_count

		annotation SummarizationSetBy = Automatic

	/// Number of beneficiaries flagged with Alzheimer's disease in this annual population group. Additive across disjoint groups; across years counts affected beneficiary-year observations.
	column 'Alzheimer''s Disease Count'
		dataType: int64
		formatString: 0
		lineageTag: 00000000-0000-0000-0000-000000000000
		sourceLineageTag: alzheimers_count
		summarizeBy: sum
		sourceColumn: alzheimers_count

		annotation SummarizationSetBy = Automatic

	/// Number of beneficiaries flagged with heart failure in this annual population group. Additive across disjoint groups; across years counts affected beneficiary-year observations.
	column 'Heart Failure Count'
		dataType: int64
		formatString: 0
		lineageTag: 00000000-0000-0000-0000-000000000000
		sourceLineageTag: heart_failure_count
		summarizeBy: sum
		sourceColumn: heart_failure_count

		annotation SummarizationSetBy = Automatic

	/// Number of beneficiaries flagged with chronic kidney disease in this annual population group. Additive across disjoint groups; across years counts affected beneficiary-year observations.
	column 'Chronic Kidney Disease Count'
		dataType: int64
		formatString: 0
		lineageTag: 00000000-0000-0000-0000-000000000000
		sourceLineageTag: chronic_kidney_disease_count
		summarizeBy: sum
		sourceColumn: chronic_kidney_disease_count

