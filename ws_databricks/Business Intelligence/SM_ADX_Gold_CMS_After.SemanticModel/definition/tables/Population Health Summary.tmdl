	/// Total Medicare reimbursement in US dollars for this annual population group, including inpatient, outpatient, and carrier amounts. Additive across disjoint groups and years.
	column 'Total Medicare Reimbursement Amount'
		dataType: double
		lineageTag: 00000000-0000-0000-0000-000000000000
		sourceLineageTag: total_medicare_reimbursement_amt
		summarizeBy: sum
		sourceColumn: total_medicare_reimbursement_amt

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Precomputed Medicare reimbursement per beneficiary in US dollars for this annual group. Non-additive; do not sum or average group ratios equally. The Reimbursement per Beneficiary measure uses distinct people over the selected period.
	column 'Medicare Reimbursement per Beneficiary'
		dataType: double
		lineageTag: 00000000-0000-0000-0000-000000000000
		sourceLineageTag: medicare_reimbursement_per_beneficiary_amt
