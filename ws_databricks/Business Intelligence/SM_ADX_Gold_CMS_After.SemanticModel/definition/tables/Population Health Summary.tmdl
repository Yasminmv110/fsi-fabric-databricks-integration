	/// Number of beneficiaries flagged with cancer in this annual population group. Additive across disjoint groups; across years counts affected beneficiary-year observations.
	column 'Cancer Count'
		dataType: int64
		formatString: 0
		lineageTag: 00000000-0000-0000-0000-000000000000
		sourceLineageTag: cancer_count
		summarizeBy: sum
		sourceColumn: cancer_count

		annotation SummarizationSetBy = Automatic

	/// Number of beneficiaries flagged with chronic obstructive pulmonary disease (COPD) in this annual population group. Across years counts affected beneficiary-year observations.
	column 'COPD Count'
		dataType: int64
		formatString: 0
		lineageTag: 00000000-0000-0000-0000-000000000000
		sourceLineageTag: copd_count
		summarizeBy: sum
		sourceColumn: copd_count

		annotation SummarizationSetBy = Automatic

	/// Number of beneficiaries flagged with depression in this annual population group. Additive across disjoint groups; across years counts affected beneficiary-year observations.
	column 'Depression Count'
		dataType: int64
		formatString: 0
		lineageTag: 00000000-0000-0000-0000-000000000000
		sourceLineageTag: depression_count
		summarizeBy: sum
		sourceColumn: depression_count

		annotation SummarizationSetBy = Automatic

	/// Number of beneficiaries flagged with diabetes in this annual population group. Additive across disjoint groups; across years counts affected beneficiary-year observations.
	column 'Diabetes Count'
		dataType: int64
		formatString: 0
		lineageTag: 00000000-0000-0000-0000-000000000000
		sourceLineageTag: diabetes_count
		summarizeBy: sum
		sourceColumn: diabetes_count

		annotation SummarizationSetBy = Automatic

	/// Number of beneficiaries flagged with ischemic heart disease in this annual population group. Across years counts affected beneficiary-year observations.
	column 'Ischemic Heart Disease Count'
		dataType: int64
		formatString: 0
		lineageTag: 00000000-0000-0000-0000-000000000000
		sourceLineageTag: ischemic_heart_disease_count
		summarizeBy: sum
		sourceColumn: ischemic_heart_disease_count

		annotation SummarizationSetBy = Automatic

	/// Number of beneficiaries flagged with osteoporosis in this annual population group. Additive across disjoint groups; across years counts affected beneficiary-year observations.
	column 'Osteoporosis Count'
		dataType: int64
		formatString: 0
		lineageTag: 00000000-0000-0000-0000-000000000000
		sourceLineageTag: osteoporosis_count
		summarizeBy: sum
		sourceColumn: osteoporosis_count

		annotation SummarizationSetBy = Automatic

	/// Number of beneficiaries flagged with rheumatoid arthritis/osteoarthritis in this annual population group. Across years counts affected beneficiary-year observations.
	column 'Rheumatoid/Osteo Arthritis Count'
		dataType: int64
		formatString: 0
		lineageTag: 00000000-0000-0000-0000-000000000000
		sourceLineageTag: rheumatoid_osteo_arthritis_count
		summarizeBy: sum
		sourceColumn: rheumatoid_osteo_arthritis_count

		annotation SummarizationSetBy = Automatic

	/// Number of beneficiaries flagged with stroke or transient ischemic attack (TIA) in this annual population group. Across years counts affected beneficiary-year observations.
	column 'Stroke/TIA Count'
		dataType: int64
		formatString: 0
		lineageTag: 00000000-0000-0000-0000-000000000000
		sourceLineageTag: stroke_tia_count
		summarizeBy: sum
		sourceColumn: stroke_tia_count

		annotation SummarizationSetBy = Automatic

	/// Precomputed diabetes prevalence for this annual population group. Non-additive: do not sum or average group rates equally. Use the Diabetes Prevalence Rate measure to recompute for the current selection.
	column 'Diabetes Prevalence Rate'
		dataType: decimal
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 00000000-0000-0000-0000-000000000000
		sourceLineageTag: diabetes_prevalence_rate
		summarizeBy: sum
		sourceColumn: diabetes_prevalence_rate

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Precomputed heart failure prevalence for this annual population group. Non-additive: do not sum or average group rates equally. Use the Heart Failure Prevalence Rate measure.
	column 'Heart Failure Prevalence Rate'
		dataType: decimal
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 00000000-0000-0000-0000-000000000000
		sourceLineageTag: heart_failure_prevalence_rate
		summarizeBy: sum
		sourceColumn: heart_failure_prevalence_rate

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Precomputed ischemic heart disease prevalence for this annual population group. Non-additive: do not sum or average group rates equally. Use the Ischemic Heart Disease Prevalence Rate measure.
	column 'Ischemic Heart Disease Prevalence Rate'
		dataType: decimal
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 00000000-0000-0000-0000-000000000000
		sourceLineageTag: ischemic_heart_disease_prevalence_rate
		summarizeBy: sum
		sourceColumn: ischemic_heart_disease_prevalence_rate

		annotation SummarizationSetBy = Automatic

