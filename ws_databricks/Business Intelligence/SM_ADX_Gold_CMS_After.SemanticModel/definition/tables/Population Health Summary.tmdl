	/// Total inpatient claim payments in US dollars for this annual population group. Distinct from annual-summary Medicare reimbursement.
	column 'Inpatient Claim Payment Amount'
		dataType: double
		lineageTag: 00000000-0000-0000-0000-000000000000
		sourceLineageTag: inpatient_claim_payment_amt
