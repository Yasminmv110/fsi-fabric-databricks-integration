		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Total beneficiary financial responsibility in US dollars recorded for this annual population group. Distinct from Medicare reimbursement and claim payment amounts.
	column 'Total Beneficiary Responsibility Amount'
		dataType: double
		lineageTag: 00000000-0000-0000-0000-000000000000
		sourceLineageTag: total_beneficiary_responsibility_amt
		summarizeBy: sum
		sourceColumn: total_beneficiary_responsibility_amt

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Total inpatient claims for beneficiaries in this annual population group. Additive across disjoint year/state/demographic groups; no provider attribution.
	column 'Inpatient Claim Count'
		dataType: int64
		formatString: 0
		lineageTag: 00000000-0000-0000-0000-000000000000
		sourceLineageTag: inpatient_claim_count
		summarizeBy: sum
		sourceColumn: inpatient_claim_count

		annotation SummarizationSetBy = Automatic

	/// Aggregated inpatient length of stay in days for this annual population group. A total, not average length of stay or distinct beneficiary count.
	column 'Inpatient Length of Stay (Days)'
		dataType: int64
		formatString: 0
		lineageTag: 00000000-0000-0000-0000-000000000000
		sourceLineageTag: inpatient_length_of_stay_days
		summarizeBy: sum
		sourceColumn: inpatient_length_of_stay_days

		annotation SummarizationSetBy = Automatic

	/// Total outpatient claims for beneficiaries in this annual population group. Additive across disjoint year/state/demographic groups; no provider attribution.
	column 'Outpatient Claim Count'
		dataType: int64
		formatString: 0
		lineageTag: 00000000-0000-0000-0000-000000000000
		sourceLineageTag: outpatient_claim_count
		summarizeBy: sum
		sourceColumn: outpatient_claim_count

