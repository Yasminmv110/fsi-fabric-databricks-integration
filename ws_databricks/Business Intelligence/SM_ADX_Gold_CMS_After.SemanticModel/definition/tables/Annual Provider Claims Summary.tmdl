/// Provider claims fact table at Provider Number, Claim Year, and Claim Type grain, containing claim/beneficiary counts, payments, cost sharing, and claim characteristics. Supports year/provider/claim-type analysis only. Beneficiary counts are not additive across providers/types/years; average columns require appropriate weighting. Coverage differs from annual beneficiary summaries, so totals need not match across all years.
table 'Annual Provider Claims Summary'
	lineageTag: 00000000-0000-0000-0000-000000000000
	sourceLineageTag: [gold].[fact_provider_annual_summary]

	/// Claim counts from annual provider claims summary. Use with Calendar Year, Provider, and Claim Type dimensions. State, Demographic, and Beneficiary dimensions do not filter this measure; joint provider/demographic or provider/state attribution is unavailable. Includes years outside beneficiary summary coverage.
	measure 'Total Provider Claims' = SUM('Annual Provider Claims Summary'[Claim Count])
		formatString: #,0
		displayFolder: Claims\Provider
		lineageTag: 00000000-0000-0000-0000-000000000000

	/// Provider-summary inpatient claim count in current year/provider context, intersected with the selected Claim Type. State, demographic, and beneficiary filters are not supported.
	measure 'Provider Inpatient Claim Count' = CALCULATE([Total Provider Claims], KEEPFILTERS('Claim Type'[Claim Type] = "Inpatient"))
		formatString: #,0
		displayFolder: Claims\Provider
		lineageTag: 00000000-0000-0000-0000-000000000000

	/// Provider-summary outpatient claim count in current year/provider context, intersected with the selected Claim Type. State, demographic, and beneficiary filters are not supported.
	measure 'Provider Outpatient Claim Count' = CALCULATE([Total Provider Claims], KEEPFILTERS('Claim Type'[Claim Type] = "Outpatient"))
		formatString: #,0
		displayFolder: Claims\Provider
		lineageTag: 00000000-0000-0000-0000-000000000000

	/// Provider identifier for this claim summary group. Foreign key to Provider and part of the provider/year/claim-type grain.
	column 'Provider Number'
		dataType: string
		lineageTag: 00000000-0000-0000-0000-000000000000
		sourceLineageTag: provider_number
		summarizeBy: none
		sourceColumn: provider_number

		annotation SummarizationSetBy = Automatic

	/// Calendar year assigned to this provider claim summary by the source. Foreign key to Calendar Year; part of the provider/year/claim-type grain.
	column 'Claim Year'
		dataType: int64
		formatString: 0
		lineageTag: 00000000-0000-0000-0000-000000000000
		sourceLineageTag: claim_year
		summarizeBy: none
		sourceColumn: claim_year

		annotation SummarizationSetBy = Automatic

	/// Inpatient or Outpatient category for this provider/year group. Foreign key to Claim Type and part of the provider/year/claim-type grain.
	column 'Claim Type'
		dataType: string
		lineageTag: 00000000-0000-0000-0000-000000000000
		sourceLineageTag: claim_type
		summarizeBy: none
		sourceColumn: claim_type

		annotation SummarizationSetBy = Automatic

	/// Number of claims in this provider/year/claim-type group. Additive across groups; source for Total Provider Claims. Does not support beneficiary state or demographic filtering.
	column 'Claim Count'
		dataType: int64
		formatString: 0
		lineageTag: 00000000-0000-0000-0000-000000000000
		sourceLineageTag: claim_count
		summarizeBy: sum
		sourceColumn: claim_count

		annotation SummarizationSetBy = Automatic

	/// Beneficiary count recorded for this provider/year/claim-type group. Not additive across providers, claim types, or years because the same person can occur in multiple groups.
	column 'Beneficiary Count'
		dataType: int64
		formatString: 0
		lineageTag: 00000000-0000-0000-0000-000000000000
		sourceLineageTag: beneficiary_count
		summarizeBy: sum
		sourceColumn: beneficiary_count

		annotation SummarizationSetBy = Automatic

	/// Total claim payments in US dollars for this provider/year/claim-type group. Additive across disjoint claim groups; not the same metric as annual beneficiary Medicare reimbursement.
	column 'Total Claim Payment Amount'
		dataType: double
		lineageTag: 00000000-0000-0000-0000-000000000000
		sourceLineageTag: total_claim_payment_amt
		summarizeBy: sum
		sourceColumn: total_claim_payment_amt

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Mean claim payment in US dollars within this provider/year/claim-type group. Non-additive; recompute overall mean from total payments divided by claim count rather than averaging group means.
	column 'Average Claim Payment Amount'
		dataType: double
		lineageTag: 00000000-0000-0000-0000-000000000000
		sourceLineageTag: avg_claim_payment_amt
		summarizeBy: sum
		sourceColumn: avg_claim_payment_amt

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Total primary-payer paid amount in US dollars recorded for claims in this provider/year/claim-type group. Distinct from the claim payment and beneficiary cost-share fields.
	column 'Total Primary Payer Paid Amount'
		dataType: double
		lineageTag: 00000000-0000-0000-0000-000000000000
		sourceLineageTag: total_primary_payer_paid_amt
		summarizeBy: sum
		sourceColumn: total_primary_payer_paid_amt

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Total beneficiary claim cost sharing in US dollars for this provider/year/claim-type group. Distinct from payer payments and annual-summary beneficiary responsibility.
	column 'Total Beneficiary Cost Share Amount'
		dataType: double
		lineageTag: 00000000-0000-0000-0000-000000000000
		sourceLineageTag: total_beneficiary_cost_share_amt
		summarizeBy: sum
		sourceColumn: total_beneficiary_cost_share_amt

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Precomputed mean claim duration in days for this provider/year/claim-type group. Non-additive; combine groups using source-consistent eligible-claim weighting, not an unweighted average.
	column 'Average Claim Duration (Days)'
		dataType: decimal
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 00000000-0000-0000-0000-000000000000
		sourceLineageTag: avg_claim_duration_days
		summarizeBy: sum
		sourceColumn: avg_claim_duration_days

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Aggregated claim length of stay in days for this provider/year/claim-type group. Interpret by claim type; not an average or a distinct count of patients/days.
	column 'Total Length of Stay (Days)'
		dataType: int64
		formatString: 0
		lineageTag: 00000000-0000-0000-0000-000000000000
		sourceLineageTag: total_length_of_stay_days
		summarizeBy: sum
		sourceColumn: total_length_of_stay_days

		annotation SummarizationSetBy = Automatic

	/// Precomputed mean claim length of stay in days for this provider/year/claim-type group. Non-additive; preserve the source's eligible-claim denominator when combining groups.
	column 'Average Length of Stay (Days)'
		dataType: decimal
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 00000000-0000-0000-0000-000000000000
		sourceLineageTag: avg_length_of_stay_days
		summarizeBy: sum
		sourceColumn: avg_length_of_stay_days

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Precomputed mean number of diagnosis codes per claim in this provider/year/claim-type group. Non-additive; combine with source-consistent eligible-claim weighting.
	column 'Average Diagnosis Code Count'
		dataType: decimal
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 00000000-0000-0000-0000-000000000000
		sourceLineageTag: avg_diagnosis_code_count
		summarizeBy: sum
		sourceColumn: avg_diagnosis_code_count

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Precomputed mean number of procedure codes per claim in this provider/year/claim-type group. Non-additive; combine with source-consistent eligible-claim weighting.
	column 'Average Procedure Code Count'
		dataType: decimal
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 00000000-0000-0000-0000-000000000000
		sourceLineageTag: avg_procedure_code_count
		summarizeBy: sum
		sourceColumn: avg_procedure_code_count

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Recorded load timestamp for this gold-layer provider claim summary record. Operational lineage metadata, not the claim year.
	column 'Gold Load Timestamp'
		dataType: dateTime
		isHidden
		formatString: General Date
		lineageTag: 00000000-0000-0000-0000-000000000000
		sourceLineageTag: _gold_load_ts
		summarizeBy: none
		sourceColumn: _gold_load_ts

		annotation SummarizationSetBy = Automatic

	partition fact_provider_annual_summary = entity
		mode: directLake
		source
			entityName: fact_provider_annual_summary
			schemaName: gold
			expressionSource: 'DirectLake - WH_ADX_CMS_Gold'
