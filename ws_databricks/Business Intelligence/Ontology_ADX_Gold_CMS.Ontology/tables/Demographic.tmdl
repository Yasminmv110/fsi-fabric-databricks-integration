		lineageTag: 00000000-0000-0000-0000-000000000000
		sourceLineageTag: 00000000-0000-0000-0000-000000000000
		sourceColumn: sex

	/// Source race category for this annual demographic grouping. Use to slice beneficiary and population-health measures; does not filter provider claims.
	column Race
