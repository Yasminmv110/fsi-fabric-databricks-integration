/// Shared year dimension filtering beneficiary and population summaries by Summary Year and provider claims by Claim Year. Fact tables can have different year coverage; provider claims include 2007 while beneficiary summaries currently cover 2008-2010.
table 'Calendar Year'
	lineageTag: 00000000-0000-0000-0000-000000000000
	sourceLineageTag: 00000000-0000-0000-0000-000000000000

	/// Four-digit calendar year shared by beneficiary/population Summary Year and provider Claim Year. Use this dimension for consistent year filters across the fact tables.
	column 'Calendar Year'
		dataType: int64
		lineageTag: 00000000-0000-0000-0000-000000000000
		sourceLineageTag: 00000000-0000-0000-0000-000000000000
		sourceColumn: calendar_year

	/// Recorded load timestamp for this gold-layer year record. Operational lineage metadata, not the analytical calendar year.
	column 'Gold Load Timestamp'
		dataType: dateTime
		lineageTag: 00000000-0000-0000-0000-000000000000
		sourceLineageTag: 00000000-0000-0000-0000-000000000000
		sourceColumn: _gold_load_ts

