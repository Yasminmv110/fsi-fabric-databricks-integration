	lineageTag: 00000000-0000-0000-0000-cb7468b76f16
	sourceLineageTag: 00000000-0000-0000-0000-f26c23291488

	/// Four-digit calendar year shared by beneficiary/population Summary Year and provider Claim Year. Use this dimension for consistent year filters across the fact tables.
	column 'Calendar Year'
		dataType: int64
		lineageTag: 00000000-0000-0000-0000-7a76a1604b2a
		sourceLineageTag: 00000000-0000-0000-0000-74f4532bdf47
		sourceColumn: calendar_year

