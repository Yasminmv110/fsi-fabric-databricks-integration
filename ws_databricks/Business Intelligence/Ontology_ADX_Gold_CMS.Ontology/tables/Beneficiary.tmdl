/// Beneficiary dimension keyed by Beneficiary ID, containing birth/death dates, sex, race, latest recorded geography, and observed summary-year range. Filters Annual Beneficiary Utilization. Latest geography is not necessarily the beneficiary's geography in an earlier year; use State and Demographic dimensions for annual breakdowns.
table Beneficiary
	lineageTag: 00000000-0000-0000-0000-000000000000
	sourceLineageTag: 00000000-0000-0000-0000-000000000000

	/// Source beneficiary identifier and unique key of the Beneficiary dimension. Joins to annual beneficiary utilization; use for distinct-person counts rather than counting annual fact rows.
	column 'Beneficiary ID'
		dataType: string
		lineageTag: 00000000-0000-0000-0000-000000000000
		sourceLineageTag: 00000000-0000-0000-0000-000000000000
		sourceColumn: beneficiary_id

	/// Beneficiary birth date as recorded in the source. Use annual Age at Year End for year-specific age analysis.
	column 'Birth Date'
		dataType: dateTime
		lineageTag: 00000000-0000-0000-0000-000000000000
		sourceLineageTag: 00000000-0000-0000-0000-000000000000
		sourceColumn: birth_date

	/// Beneficiary death date as recorded in the source. A blank date means no death date is recorded, not independently verified living status.
	column 'Death Date'
		dataType: dateTime
		lineageTag: 00000000-0000-0000-0000-000000000000
		sourceLineageTag: 00000000-0000-0000-0000-000000000000
		sourceColumn: death_date

	/// Beneficiary sex category as supplied by the source. For annual demographic filtering, use the related Demographic dimension.
	column Sex
		dataType: string
		lineageTag: 00000000-0000-0000-0000-000000000000
		sourceLineageTag: 00000000-0000-0000-0000-000000000000
		sourceColumn: sex

	/// Beneficiary race category as supplied by the source. For annual demographic filtering, use the related Demographic dimension.
	column Race
		dataType: string
		lineageTag: 00000000-0000-0000-0000-000000000000
		sourceLineageTag: 00000000-0000-0000-0000-000000000000
		sourceColumn: race

	/// Latest recorded source-system state code for the beneficiary. May differ from the state recorded in earlier annual summaries; not a relationship key to the State dimension.
	column 'Latest State Code'
		dataType: string
		lineageTag: 00000000-0000-0000-0000-000000000000
		sourceLineageTag: 00000000-0000-0000-0000-000000000000
		sourceColumn: latest_state_code

	/// Latest recorded source-system county code for the beneficiary. Interpret with the corresponding state code; not necessarily the county in earlier summary years.
	column 'Latest County Code'
		dataType: string
		lineageTag: 00000000-0000-0000-0000-000000000000
		sourceLineageTag: 00000000-0000-0000-0000-000000000000
		sourceColumn: latest_county_code

	/// Earliest summary year observed for the beneficiary in the loaded data; not necessarily the first year of Medicare enrollment.
	column 'First Summary Year'
		dataType: int64
		lineageTag: 00000000-0000-0000-0000-000000000000
		sourceLineageTag: 00000000-0000-0000-0000-000000000000
		sourceColumn: first_summary_year

	/// Latest summary year observed for the beneficiary in the loaded data; not necessarily the last year of Medicare enrollment.
	column 'Last Summary Year'
		dataType: int64
		lineageTag: 00000000-0000-0000-0000-000000000000
		sourceLineageTag: 00000000-0000-0000-0000-000000000000
		sourceColumn: last_summary_year

	/// Recorded load timestamp for this gold-layer beneficiary record. Operational lineage metadata, not a birth, death, or coverage date.
	column 'Gold Load Timestamp'
		dataType: dateTime
		lineageTag: 00000000-0000-0000-0000-000000000000
		sourceLineageTag: 00000000-0000-0000-0000-000000000000
		sourceColumn: _gold_load_ts

