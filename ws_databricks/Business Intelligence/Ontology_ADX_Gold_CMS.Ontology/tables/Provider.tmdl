/// Provider dimension keyed by Provider Number, containing observed claim-year range and indicators for inpatient/outpatient claims. Filters Annual Provider Claims Summary only; the model has no provider-to-beneficiary/state/demographic attribution.
table Provider
	lineageTag: 00000000-0000-0000-0000-000000000000
	sourceLineageTag: 00000000-0000-0000-0000-000000000000

	/// Source provider identifier and unique key of the Provider dimension. Joins to Annual Provider Claims Summary; not assumed to be a National Provider Identifier.
	column 'Provider Number'
		dataType: string
		lineageTag: 00000000-0000-0000-0000-000000000000
		sourceLineageTag: 00000000-0000-0000-0000-000000000000
		sourceColumn: provider_number

	/// Earliest claim year observed for this provider in the loaded data; not necessarily the provider's first year of operation.
	column 'First Claim Year'
		dataType: int64
		lineageTag: 00000000-0000-0000-0000-000000000000
		sourceLineageTag: 00000000-0000-0000-0000-000000000000
		sourceColumn: first_claim_year

	/// Latest claim year observed for this provider in the loaded data; not necessarily the provider's last year of operation.
	column 'Last Claim Year'
		dataType: int64
		lineageTag: 00000000-0000-0000-0000-000000000000
		sourceLineageTag: 00000000-0000-0000-0000-000000000000
		sourceColumn: last_claim_year

	/// Source indicator that this provider has inpatient claims in the loaded data. Describes observed claim-type presence, not the number of claims.
	column 'Has Inpatient Claims'
		dataType: int64
		lineageTag: 00000000-0000-0000-0000-000000000000
		sourceLineageTag: 00000000-0000-0000-0000-000000000000
		sourceColumn: has_inpatient_claims

	/// Source indicator that this provider has outpatient claims in the loaded data. Describes observed claim-type presence, not the number of claims.
	column 'Has Outpatient Claims'
		dataType: int64
		lineageTag: 00000000-0000-0000-0000-000000000000
		sourceLineageTag: 00000000-0000-0000-0000-000000000000
		sourceColumn: has_outpatient_claims

	/// Recorded load timestamp for this gold-layer provider record. Operational lineage metadata, not a claim date.
	column 'Gold Load Timestamp'
		dataType: dateTime
		lineageTag: 00000000-0000-0000-0000-000000000000
		sourceLineageTag: 00000000-0000-0000-0000-000000000000
		sourceColumn: _gold_load_ts

	partition Provider-partition = entity
		mode: directQuery
		source
			entityName: Provider
			expressionSource: 'DirectQuery to AS - 00000000-0000-0000-0000-000000000000/00000000-0000-0000-0000-000000000000'

