/// State-code dimension used to filter annual beneficiary utilization and population health summaries by the state recorded for the summary year. Codes are source-system geographic identifiers, not necessarily postal abbreviations. Does not filter provider claims.
entity State
	lineageTag: 00000000-0000-0000-0000-3e4aa7af1a1d
	backingTable: State

	/// Source-system state identifier and key of the State dimension. Joins to state codes in annual beneficiary and population summaries; do not assume postal abbreviations or provider location.
	property state_code
		dataType: string
		lineageTag: 00000000-0000-0000-0000-d30cdb9c05ff

		backingConfiguration
			valueColumn: State.'State Code'

		synonym 'State Code'

		synonym 'State Identifier'

	/// Recorded load timestamp for this gold-layer state record. Operational lineage metadata.
	property _gold_load_ts
		dataType: dateTime
		lineageTag: 00000000-0000-0000-0000-9f792d47057d

		backingConfiguration
			valueColumn: State.'Gold Load Timestamp'

		synonym 'Gold Load Timestamp'

		synonym 'Gold Layer Load Timestamp'

		synonym 'Gold Load Time'

