/// Annual beneficiary-level fact table at beneficiary-year grain, with annual geography/demographics, age, coverage months, condition indicators, Medicare reimbursement, and inpatient/outpatient utilization. Supports year/state/demographic/beneficiary analysis. Multi-year population averages and prevalence measures are beneficiary-year weighted; Total Beneficiaries counts distinct people. No provider relationship.
entity 'Annual Beneficiary Utilization'
	lineageTag: 00000000-0000-0000-0000-000000000000
	backingTable: 'Annual Beneficiary Utilization'

	/// Beneficiary identifier for this annual observation; foreign key to Beneficiary. A beneficiary can appear in multiple summary years.
	property beneficiary_id
		dataType: string
		lineageTag: 00000000-0000-0000-0000-000000000000

		backingConfiguration
			valueColumn: 'Annual Beneficiary Utilization'.'Beneficiary ID'

		synonym 'Beneficiary ID'

		synonym 'Member ID'

		synonym 'Person ID'

	/// Calendar year represented by this beneficiary's annual summary. Foreign key to Calendar Year.
	property summary_year
		dataType: int64
		lineageTag: 00000000-0000-0000-0000-000000000000

		backingConfiguration
			valueColumn: 'Annual Beneficiary Utilization'.'Summary Year'

		synonym 'Summary Year'

		synonym 'Beneficiary Summary Year'

	/// Source state code recorded for this beneficiary in the summary year. Foreign key to State; may differ from the beneficiary dimension's latest state.
	property state_code
		dataType: string
		lineageTag: 00000000-0000-0000-0000-000000000000

		backingConfiguration
			valueColumn: 'Annual Beneficiary Utilization'.'State Code'

		synonym 'State Code'

