# Optional local identifiers for the Fabric + Azure Databricks demo.
# Copy to .env and replace placeholders. No repository code loads this file.
# These values do not provision resources, authenticate, or configure connections.
# Do not add passwords, tokens, client secrets, or customer data.

# Microsoft Entra tenant and Azure subscription identifiers.
AZURE_TENANT_ID=<tenant-id>
AZURE_SUBSCRIPTION_ID=<subscription-id>
AZURE_RESOURCE_GROUP=<demo-resource-group>

# Existing Microsoft Fabric workspace and capacity identifiers.
FABRIC_WORKSPACE_ID=<fabric-workspace-id>
FABRIC_CAPACITY_ID=<fabric-capacity-id>

# Existing Azure Databricks workspace and Unity Catalog source.
DATABRICKS_HOST=https://<workspace-host>
DATABRICKS_CATALOG=<demo-catalog>
DATABRICKS_SCHEMA=<demo-schema>
